{
	"name": "loopiq-agent",
	"private": true,
	"type": "module",
	"workspaces": ["packages/*"],
	"scripts": {
		"clean": "npm run clean --workspaces --if-present",
		"build": "npm run build -w @loopiq/ai && npm run build -w @loopiq/agent && npm run build -w @loopiq/cli",
		"test": "npm run test --workspaces --if-present",
		"check": "biome check --write .",
		"devui": "npm run server -w @loopiq/server"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.5",
		"@types/node": "22.19.19",
		"@typescript/native-preview": "7.0.0-dev.20260120.1",
		"shx": "0.4.0",
		"typescript": "5.9.3"
	},
	"engines": {
		"node": ">=22.19.0"
	}
}
